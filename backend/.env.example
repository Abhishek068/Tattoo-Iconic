# Django Core Settings
DJANGO_SECRET_KEY=django-insecure-change-this-in-production-key
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ==============================================================================
# PostgreSQL Database Configuration
# ==============================================================================
USE_POSTGRES=True
DB_ENGINE=django.db.backends.postgresql
DB_NAME=tatto
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Or Database URL:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/tattoo_db

# ==============================================================================
# Meta & Instagram Graph API Credentials
# ==============================================================================
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_HANDLE=tatoo.iconic

# Artist & Studio Metadata
ARTIST_NAME=Jainik Patel
ARTIST_PHONE=+918238767100
ARTIST_STUDIO=Tattoo Iconic
STUDIO_LOCATION=At-Post Bhadam, Taluka- Rajpipla, District- Narmada, Gujarat

# Sync & Pagination Settings
INSTAGRAM_AUTO_PUBLISH=False
