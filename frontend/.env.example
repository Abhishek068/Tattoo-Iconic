# ── Tattoo Iconic Phase 1 Environment Variables ──

# ==============================================================================
# 1. PRIVATE SERVER-SIDE SECRETS (NEVER EXPOSE IN CLIENT CODE OR NEXT_PUBLIC_*)
# ==============================================================================

# Private Artist Security Secret (Validated server-side only in Next.js)
ARTIST_DASHBOARD_SECRET=

# Google Sheets Service Account Credentials (Method A)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Google Sheets Webhook URL via Google Apps Script (Method B - Easiest 1-step setup)
GOOGLE_SHEET_WEBHOOK_URL=

# Direct Email Notification for New Enquiries
ARTIST_NOTIFICATION_EMAIL=Jainik.patel.33@gmail.com
RESEND_API_KEY=
NOTIFICATION_WEBHOOK_URL=

# ==============================================================================
# 2. PUBLIC ENVIRONMENT VARIABLES (SAFE FOR CLIENT BUNDLES)
# ==============================================================================

# Public WhatsApp Contact Number (digits with international country code without +, e.g. 447XXXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Public Google Sheet Direct URL (For Artist Dashboard shortcut)
NEXT_PUBLIC_GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets

# Public Canonical Site URL
NEXT_PUBLIC_SITE_URL=https://tattooiconic.in

# Public Instagram Handle
NEXT_PUBLIC_INSTAGRAM_HANDLE=tatoo.iconic
